DATABASE_URL="postgresql://user:password@localhost:5432/pocketledger"

# NextAuth / Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="same-value-as-AUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — needed for "Continue with Google")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (for email OTP verification + reminder emails)
RESEND_API_KEY=""
EMAIL_FROM="PocketLedger <noreply@yourdomain.com>"
