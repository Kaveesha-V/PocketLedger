// PocketLedger — Prisma Schema
// Emerald Night design system • PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
//  Enums
// ─────────────────────────────────────────────

enum EntryType {
  INCOME
  EXPENSE
}

enum LedgerDirection {
  I_GAVE       // I lent money to friend
  I_BORROWED   // I borrowed money from friend
  THEY_REPAID  // Friend repaid me
  I_REPAID     // I repaid friend
}

enum Channel {
  EMAIL
  WHATSAPP
}

// ─────────────────────────────────────────────
//  Models
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  phone             String?   // WhatsApp number with country code
  currency          String    @default("LKR")
  theme             String    @default("light")
  reminderTemplates String?   @db.Text
  createdAt         DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  budgets      BudgetEntry[]
  categories   Category[]
  friends      Friend[]
  transactions LedgerTransaction[]
  reminders    ReminderLog[]
}

model Category {
  id     String    @id @default(cuid())
  userId String
  name   String
  type   EntryType
  color  String?
  icon   String?

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries BudgetEntry[]
}

model BudgetEntry {
  id         String    @id @default(cuid())
  userId     String
  date       DateTime
  title      String
  categoryId String?
  type       EntryType
  amount     Decimal   @db.Decimal(12, 2)
  method     String?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
}

model Friend {
  id       String  @id @default(cuid())
  userId   String
  name     String
  email    String?
  phone    String?
  note     String?
  archived Boolean @default(false)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LedgerTransaction[]
  reminders    ReminderLog[]
}

model LedgerTransaction {
  id        String          @id @default(cuid())
  userId    String
  friendId  String
  direction LedgerDirection
  amount    Decimal         @db.Decimal(12, 2)
  date      DateTime
  reason    String?
  dueDate   DateTime?
  settled   Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  friend Friend @relation(fields: [friendId], references: [id], onDelete: Cascade)
}

model ReminderLog {
  id       String   @id @default(cuid())
  userId   String
  friendId String
  channel  Channel
  message  String   @db.Text
  status   String
  sentAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  friend Friend @relation(fields: [friendId], references: [id], onDelete: Cascade)
}
